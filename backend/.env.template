# =============================================================================
# HealthCopilot Backend — Environment Configuration
# COPY THIS FILE TO: backend/.env  (it is already in .gitignore)
# NEVER commit real credentials to git.
# =============================================================================

# -----------------------------------------------------------------------------
# DATABASE — Supabase Session Pooler (recommended for serverless/FastAPI)
#
# Find this in: Supabase Dashboard → Project Settings → Database → Connection string
# Select "Session mode" (port 5432).
#
# If your password contains special chars (@, /, :, #, ?, [, ]) EITHER:
#   Option A: Percent-encode the password in the URL  e.g. "p@ss" → "p%40ss"
#   Option B: Leave DATABASE_URL blank and set the component vars below
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres.YOURPROJECTREF:YOURPASSWORD@aws-0-ap-northeast-1.pooler.supabase.com:5432/postgres

# Component vars (fallback when DATABASE_URL password has unsafe chars)
# DB_USER=postgres.YOURPROJECTREF
# DB_PASSWORD=YOURPASSWORD
# DB_HOST=aws-0-ap-northeast-1.pooler.supabase.com
# DB_PORT=5432
# DB_NAME=postgres

# -----------------------------------------------------------------------------
# AUTHENTICATION — replace with a long random secret in production
# Generate one: python -c "import secrets; print(secrets.token_hex(32))"
# -----------------------------------------------------------------------------
JWT_SECRET=REPLACE_WITH_STRONG_RANDOM_SECRET_AT_LEAST_32_CHARS

# -----------------------------------------------------------------------------
# AI / LLM
# -----------------------------------------------------------------------------
GROQ_API_KEY=your_groq_api_key_here

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
ENVIRONMENT=production
